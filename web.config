<?xml version="1.0" encoding="utf-8"?>

<configuration>

  <system.webServer>

    <handlers>

      <add
        name="Python FastCGI"
        path="*"
        verb="*"
        modules="FastCgiModule"
        scriptProcessor="C:\Users\Dell\AppData\Local\Programs\Python\Python314\python.exe|C:\Users\Dell\AppData\Local\Programs\Python\Python314\Lib\site-packages\wfastcgi.py"
        resourceType="Unspecified"
        requireAccess="Script"/>

    </handlers>

  </system.webServer>

  <appSettings>

    <add key="PYTHONPATH"
         value="C:\inetpub\wwwroot\hotelmanagement_backend"/>

    <add key="WSGI_HANDLER"
         value="hotel.wsgi.application"/>

    <add key="DJANGO_SETTINGS_MODULE"
         value="hotel.settings"/>

  </appSettings>

</configuration>